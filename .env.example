# 复制为 .env 后修改
# 宿主机在局域网中的 IP（播放/下载直链依赖它，务必正确）
LAN_IP=192.168.1.100

# 若使用公网域名暴露系统，请直接配置 PUBLIC_BASE_URL（如 https://yourdomain.com），此时 LAN_IP 可不配置
# PUBLIC_BASE_URL=

# nginx 对外服务总端口（站点入口；改成如 8080/8443 可避开端口占用）
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

POSTGRES_USER=lvs
POSTGRES_PASSWORD=lvs_password
POSTGRES_DB=lvs

MINIO_ROOT_USER=lvsminio
MINIO_ROOT_PASSWORD=lvsminio_secret

JWT_SECRET=please_change_this_long_random_string

# 腾讯云 TRTC（直播/连麦必填）：https://console.cloud.tencent.com/trtc 创建应用获取
# SDKAppID（数字）与 SDKSecretKey；未配置时直播/连麦接口返回明确错误（不降级）
# OBS RTMP 推流进房需开通 RTC-Engine 基础版/专业版套餐
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=

# 首次启动自动创建的管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
